rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User Profiles: Only authenticated owner can read or write their own user doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Orders:
    // - Authenticated users can read only their own orders (matching uid or email)
    // - Creation allowed during checkout (guest or authenticated)
    // - Updates / Deletes disallowed directly from client
    match /orders/{orderId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.userEmail == request.auth.token.email
      );
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
