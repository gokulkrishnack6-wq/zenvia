# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Store Owner Notification Email
STORE_OWNER_EMAIL="zenviashopindia@gmail.com"

# Optional SMTP Email Delivery Service Configuration
# For Gmail: Use a 16-character Google App Password (https://myaccount.google.com/apppasswords)
# Host is optional if user is a @gmail.com address (service: 'gmail' is auto-detected).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Razorpay Business Merchant Payment Gateway Configuration
# 1. Obtain your Key ID and Key Secret from the Razorpay Dashboard (https://dashboard.razorpay.com)
# 2. In your Razorpay Dashboard under Settings > Account & Settings > Business Profile, ensure
#    the Business Name is configured as "ZENVIA" so Google Pay, PhonePe, Paytm, and UPI PSPs display "ZENVIA"
#    as the official receiving merchant instead of any personal name.
# 3. Configure RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET in Settings > Secrets.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MERCHANT_NAME=ZENVIA

# Firebase Client Authentication & Firestore Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
